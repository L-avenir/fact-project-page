---
const headers = ['Method', 'CD ↓', 'SD-P95 ↓', 'F@1% ↑', 'F@2% ↑', 'Avg. SIoU ↑', 'Min. SIoU ↑'];
const groups = [
  { label: 'Image inputs', rows: [
    { name: 'Codex (GPT-6)', values: ['1.1238', '3.6060', '0.6148', '0.8237', '0.8813', '0.8310'], best: [] },
    { name: 'Articraft (GPT-6)', values: ['1.3117', '3.3719', '0.5687', '0.7615', '0.8597', '0.8068'], best: [] },
    { name: 'FACT (GPT-6; original)', values: ['1.0821', '2.7884', '0.6838', '0.8391', '0.9381', '0.9166'], best: [1, 4, 5] },
    { name: 'FACT (GPT-6; parts)', values: ['1.0317', '2.9972', '0.6937', '0.8519', '0.9317', '0.9051'], best: [0, 2, 3] },
    { name: 'Rodin (original)', values: ['1.6840', '1.9756', '0.5663', '0.7206', '0.9393', '0.9164'], best: [] },
    { name: 'Rodin (parts)', values: ['1.4353', '2.6555', '0.6041', '0.7703', '0.9336', '0.9075'], best: [] },
  ] },
  { label: 'Oracle mesh inputs', rows: [
    { name: 'CAD-Recode', values: ['1.2073', '3.1952', '0.6164', '0.7990', '0.8596', '0.7475'], best: [] },
    { name: 'MeshCoder', values: ['3.4268', '6.9213', '0.3541', '0.5018', '0.6366', '0.5035'], best: [] },
    { name: 'PrimitiveAnything', values: ['1.4028', '4.7916', '0.5354', '0.7520', '0.8241', '0.7674'], best: [] },
    { name: 'SuperFlex', values: ['1.9266', '3.2654', '0.3937', '0.6578', '0.8852', '0.8455'], best: [] },
    { name: 'Codex (GPT-6)', values: ['0.5402', '1.0572', '0.8783', '0.9291', '0.9888', '0.9790'], best: [] },
    { name: 'FACT (GPT-6)', values: ['0.0874', '0.3740', '0.9899', '0.9990', '0.9902', '0.9861'], best: [0, 1, 2, 3, 4, 5] },
  ] },
];
---
<div class="results-table geometry-table" role="region" aria-label="Table 1: Quantitative comparison of geometry fidelity" tabindex="0">
  <table>
    <caption><strong>Table 1. Quantitative comparison of geometry fidelity.</strong> Gray rows show upstream Rodin meshes for reference; bold marks the best reconstruction results within each setting.</caption>
    <thead><tr>{headers.map(header => <th scope="col">{header}</th>)}</tr></thead>
    {groups.map(group => <tbody>
      <tr class="table-group"><th colspan="7" scope="rowgroup">{group.label}</th></tr>
      {group.rows.map(row => <tr class:list={{'fact-row': row.name.startsWith('FACT'), 'upstream-row': row.name.startsWith('Rodin')}}>
        <th scope="row">{row.name.startsWith('FACT') ? <><strong>FACT</strong>{row.name.slice(4)}</> : row.name}</th>
        {row.values.map((value, i) => <td>{row.best.includes(i) ? <strong>{value}</strong> : value}</td>)}
      </tr>)}
    </tbody>)}
  </table>
</div>
