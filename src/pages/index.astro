---
import "@fontsource-variable/noto-sans/wght.css";

import Table from "../components/Table.astro";
import { getImage } from "astro:assets";
import teaser from "../assets/fact/teaser.png";

import "../styles/global.css";
import "../styles/fact.css";
import "katex/dist/katex-swap.css";

import { Content, frontmatter } from "../paper.mdx";

interface Frontmatter {
  title: string;
  description?: string;
  favicon: string;
  theme?: "device" | "light" | "dark";
}

const {
  title,
  description,
  favicon,
  theme = "device",
} = frontmatter as Frontmatter;

const baseUrl = import.meta.env.BASE_URL;
const prefix = baseUrl.endsWith("/") ? baseUrl : baseUrl + "/";
const canonicalUrl = new URL(prefix, Astro.site).href;
const sitemapUrl = new URL("sitemap-index.xml", canonicalUrl).href;
const socialImage = await getImage({ src: teaser, width: 1200, format: "png" });
const socialImageUrl = new URL(socialImage.src, Astro.site).href;
const imageAlt = "FACT: geometry reconstruction, contact refinement, and dynamic calibration of articulated twins.";
const authors = [
  { name: "Kuixiang Shao", url: "https://openreview.net/profile?id=~Kuixiang_Shao1" },
  { name: "Chuansen Nie", url: "https://openreview.net/profile?id=~Chuansen_Nie1" },
  { name: "Yinuo Bai", url: "https://scholar.google.com/citations?user=9VoenOYAAAAJ&hl=zh-CN&oi=ao" },
  { name: "Jiayuan Gu", url: "https://jiayuan-gu.github.io/" },
  { name: "Jingyi Yu", url: "https://www.yu-jingyi.com/" },
];
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": canonicalUrl,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: "en",
  image: socialImageUrl,
  mainEntity: {
    "@type": "ScholarlyArticle",
    "@id": "https://arxiv.org/abs/2609.37067",
    url: "https://arxiv.org/abs/2609.37067",
    name: title,
    headline: title,
    description,
    datePublished: "2026-09-29",
    identifier: "arXiv:2609.37067",
    image: socialImageUrl,
    author: authors.map(author => ({
      "@type": "Person",
      ...author,
      affiliation: { "@type": "Organization", name: "ShanghaiTech University" },
    })),
  },
};
---

<!doctype html>
<html class="bg-white dark:bg-zinc-900" lang="en" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    {description && <meta name="description" content={description} />}
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="QSSBciTNXpmPZcw2fFRbR3EwTg5IBe7beyZn13tqWhc" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href={sitemapUrl} />

    <link rel="icon" type="image/svg+xml" href={prefix + favicon} />

    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="FACT" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={socialImage.attributes.width} />
    <meta property="og:image:height" content={socialImage.attributes.height} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <meta name="citation_title" content={title} />
    {authors.map(author => <meta name="citation_author" content={author.name} />)}
    <meta name="citation_publication_date" content="2026/09/29" />
    <meta name="citation_arxiv_id" content="2609.37067" />
    <meta name="citation_pdf_url" content="https://arxiv.org/pdf/2609.37067" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")} />


    <noscript><style>image-state .image-status{display:none!important}image-state img{opacity:1!important}</style></noscript>
    <title>{title}</title>
  </head>
  <body class="fact-site font-(family-name:--font-noto-sans)">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <main id="main-content">
      <Content components={{ table: Table }} />
    </main>
    <footer class="mx-auto max-w-[50rem] px-6 text-center">
      <p class="prose-sm text-center">
        Built with <a
          href="https://research-template.roman.technology"
          rel="nofollow">Roman Hauksson-Neill's project page template</a
        >
      </p>
    </footer>
  </body>
</html>
