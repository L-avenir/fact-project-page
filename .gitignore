# Only website source, build configuration, and deliberate public assets belong here.
/*
!/.gitignore
!/.prettierignore
!/README.md
!/astro.config.ts
!/eslint.config.ts
!/package.json
!/package-lock.json
!/prettier.config.ts
!/tsconfig.json
!/.github/
!/src/
!/public/

/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/astro.yml

/public/*
!/public/favicon.svg
!/public/media/
# Tracked media remains versioned. Add new published media deliberately with git add -f.
/public/media/**

# Generated files, dependencies, credentials, and local research material.
node_modules/
dist/
.astro/
.env*
*.log
.DS_Store
